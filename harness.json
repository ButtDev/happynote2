{
  "verify": [
    {
      "name": "harness",
      "cmd": "node .claude/harness/status.mjs --json > /dev/null",
      "timeoutSec": 60
    },
    {
      "name": "build",
      "cmd": "npm run build",
      "timeoutSec": 300
    },
    {
      "name": "test",
      "cmd": "PATH=\"$PWD/tests/fixtures/bin:$PATH\" npm test",
      "timeoutSec": 300
    },
    {
      "name": "ui",
      "cmd": "node tests/ui/runUiCheck.mjs --fail-on-overlap",
      "timeoutSec": 300
    }
  ],
  "regression": [
    "harness",
    "build",
    "test",
    "ui"
  ],
  "detachAfterSec": 120,
  "memoryMaxKB": 20,
  "night": {
    "enabled": false,
    "improve": true,
    "maxNightBranches": 2
  }
}
