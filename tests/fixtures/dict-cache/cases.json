{
  "_about": "SPEC_047 사전 결과 캐시. 단계마다 respond = 가짜 사전 응답(ok | 404 | fail(오프라인 던짐) | 503), calls = 그 단계에서 사전을 부른 수, expect = entry | null | throw. advanceDays = 단계 전에 시계를 돌림. reopen = 같은 파일로 새 제공자. fill = 앞에 낱말 count개를 하루 1초 간격으로 채움. file = 처음 파일 글. 끝에 keys(있어야 함)·absent(없어야 함)·writes(쓰기 수, min/max)를 봄.",
  "constants": { "DICT_CACHE_SCHEMA_VERSION": 1, "DICT_CACHE_MAX": 1000, "DICT_MISS_TTL_DAYS": 7 },
  "scenarios": [
    { "name": "처음 → 네트워크 1번·저장, 다시 → 0번·같은 결과",
      "steps": [ { "lookup": "hello", "respond": "ok", "calls": 1, "expect": "entry" }, { "lookup": "hello", "calls": 0, "expect": "entry" } ],
      "keys": ["hello"], "writes": { "min": 1 } },
    { "name": "앱을 다시 켜도(파일) 네트워크 0번",
      "steps": [ { "lookup": "hello", "respond": "ok", "calls": 1, "expect": "entry" }, { "reopen": true, "lookup": "hello", "calls": 0, "expect": "entry" } ],
      "keys": ["hello"] },
    { "name": "대소문자·구두점이 달라도 한 키",
      "steps": [ { "lookup": "Hello,", "respond": "ok", "calls": 1, "expect": "entry" }, { "lookup": "HELLO!", "calls": 0, "expect": "entry" }, { "lookup": "“hello”", "calls": 0, "expect": "entry" } ],
      "keys": ["hello"], "keyCount": 1 },
    { "name": "404 → null 저장, 7일 안 0번, 8일 뒤 1번",
      "steps": [ { "lookup": "qwzxv", "respond": "404", "calls": 1, "expect": null }, { "advanceDays": 6, "lookup": "qwzxv", "calls": 0, "expect": null }, { "advanceDays": 2, "lookup": "qwzxv", "respond": "404", "calls": 1, "expect": null } ],
      "keys": ["qwzxv"] },
    { "name": "없음 기억도 다시 켠 뒤 유지",
      "steps": [ { "lookup": "qwzxv", "respond": "404", "calls": 1, "expect": null }, { "reopen": true, "advanceDays": 3, "lookup": "qwzxv", "calls": 0, "expect": null } ] },
    { "name": "오프라인 실패 → 저장 안 함, 다음에 다시 1번",
      "steps": [ { "lookup": "run", "respond": "fail", "calls": 1, "expect": "throw", "absentNow": ["run"] }, { "reopen": true, "lookup": "run", "respond": "ok", "calls": 1, "expect": "entry" } ],
      "keys": ["run"] },
    { "name": "5xx 실패도 저장 안 함",
      "steps": [ { "lookup": "run", "respond": "503", "calls": 1, "expect": "throw" }, { "lookup": "run", "respond": "ok", "calls": 1, "expect": "entry" } ] },
    { "name": "1001개째 → 가장 오래 안 쓴 것 빠짐(최근에 다시 본 w0는 남음)",
      "fill": 1000,
      "steps": [ { "advanceDays": 1, "lookup": "w0", "calls": 0, "expect": "entry" }, { "lookup": "newword", "respond": "ok", "calls": 1, "expect": "entry" } ],
      "keys": ["w0", "w2", "w999", "newword"], "absent": ["w1"], "keyCount": 1000 },
    { "name": "깨진 파일 → 빈 캐시로 시작, 새로 씀",
      "file": "{\"schemaVersion\":1,\"entries\":",
      "steps": [ { "lookup": "hello", "respond": "ok", "calls": 1, "expect": "entry" } ],
      "keys": ["hello"], "writes": { "min": 1 } },
    { "name": "항목 하나 깨짐 → 그것만 버림",
      "file": "{\"schemaVersion\":1,\"entries\":{\"bad\":{\"entry\":5,\"at\":\"x\"},\"qwzxv\":{\"entry\":null,\"at\":\"2026-11-24T00:00:00.000Z\",\"used\":\"2026-11-24T00:00:00.000Z\"}}}",
      "steps": [ { "lookup": "bad", "respond": "404", "calls": 1, "expect": null }, { "lookup": "qwzxv", "calls": 0, "expect": null } ] },
    { "name": "schemaVersion 2 → 읽기만(쓰기 0번)",
      "file": "{\"schemaVersion\":2,\"entries\":{\"qwzxv\":{\"entry\":null,\"at\":\"2026-11-24T00:00:00.000Z\",\"used\":\"2026-11-24T00:00:00.000Z\"}}}",
      "steps": [ { "lookup": "qwzxv", "calls": 0, "expect": null }, { "lookup": "hello", "respond": "ok", "calls": 1, "expect": "entry" }, { "lookup": "hello", "calls": 0, "expect": "entry" } ],
      "writes": { "max": 0 } },
    { "name": "찾을 수 없는 글자(숫자·빈칸) → 네트워크 0번, 저장 0번",
      "steps": [ { "lookup": "123", "calls": 0, "expect": null }, { "lookup": " ... ", "calls": 0, "expect": null } ],
      "writes": { "max": 0 }, "keyCount": 0 }
  ],
  "real": { "_about": "실제 dictionaryapi.dev 응답(+Commons 발음)을 캐시에 넣고 파일을 다시 읽어 결과가 처음과 같음", "word": "run", "response": "tests/fixtures/dictionary/run.json", "commons": "tests/fixtures/dictionary/commons/run-us.json" }
}
