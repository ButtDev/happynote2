{
  "name": "모바일에서 Node 내장 모듈을 최상위 import/require하지 않음 (CLAUDE.md 0장, platform.ts 지연 로딩만)",
  "srcDir": "src",
  "bundle": "main.js",
  "forbidden": [
    "assert", "buffer", "child_process", "cluster", "crypto", "dgram", "dns", "events",
    "fs", "fs/promises", "http", "http2", "https", "module", "net", "os", "path",
    "perf_hooks", "process", "readline", "stream", "string_decoder", "timers", "tls",
    "tty", "url", "util", "v8", "vm", "worker_threads", "zlib"
  ],
  "detectorCases": [
    { "code": "import type { ChildProcessWithoutNullStreams } from \"child_process\";", "violations": [] },
    { "code": "import { spawn } from \"child_process\";", "violations": ["child_process"] },
    { "code": "import * as fs from 'node:fs';", "violations": ["fs"] },
    { "code": "import {\n  readFile,\n  writeFile,\n} from \"fs/promises\";", "violations": ["fs/promises"] },
    { "code": "import \"os\";", "violations": ["os"] },
    { "code": "export { join } from \"path\";", "violations": ["path"] },
    { "code": "const cp = require(\"child_process\");", "violations": ["child_process"] },
    { "code": "const cp = requireDesktopModule<typeof import(\"child_process\")>(\"child_process\");", "violations": [] },
    { "code": "import { Platform } from \"obsidian\";\nimport { x } from \"./utils/path\";", "violations": [] },
    { "code": "// require(\"fs\") in a comment is fine\nconst s = \"path\";", "violations": [] }
  ]
}
