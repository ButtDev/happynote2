{
  "viewports": [
    {
      "name": "portrait",
      "width": 412,
      "height": 915,
      "expect": {
        "maxOverlapVideoControlsPx2": 0,
        "maxOverlayOnVideoPx2": 0,
        "insideViewport": [
          "video",
          "controls",
          "toolbar",
          "list"
        ],
        "minCards": 3,
        "layout": "stacked",
        "minVideoWidth": 380,
        "visible": [
          ".view-header",
          ".mobile-navbar"
        ]
      }
    },
    {
      "name": "landscape",
      "width": 915,
      "height": 412,
      "expect": {
        "maxOverlapVideoControlsPx2": 0,
        "maxOverlayOnVideoPx2": 0,
        "insideViewport": [
          "video",
          "controls",
          "toolbar",
          "list"
        ],
        "minCards": 3,
        "layout": "sideBySide",
        "videoAspect": 1.7777777777777777,
        "videoAspectTolerance": 0.03,
        "minVideoHeight": 240,
        "minListHeight": 280,
        "hidden": [
          ".view-header",
          ".mobile-navbar"
        ],
        "maxVideoTop": 60,
        "rootFillsViewport": {
          "bottomSlack": 12
        },
        "maxHeight": {
          ".ear-coach-mobile-toolbar": 44,
          ".ear-coach-player-controls": 44
        },
        "maxVideoSideGap": 12,
        "minListWidth": 330,
        "noOverflowX": [
          ".ear-coach-mobile-toolbar",
          ".ear-coach-player-controls"
        ],
        "diag": {
          "title": "Ear-Coach 화면 진단",
          "minChain": 4,
          "topHits": 5
        }
      }
    }
  ],
  "selectors": {
    "root": ".ear-coach-mobile-container",
    "video": ".ear-coach-video-box",
    "controls": [
      ".ear-coach-player-controls",
      ".ear-coach-mobile-toolbar"
    ],
    "list": ".ear-coach-mobile-list-wrapper",
    "segmentCard": ".ear-coach-segment-list > *",
    "toolbar": ".ear-coach-mobile-toolbar"
  },
  "overlayExclude": [
    ".ear-coach-video-thumbnail",
    "iframe",
    "[id^='ear-coach-player-']",
    ".mobile-navbar"
  ]
}
